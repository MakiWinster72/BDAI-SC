# =========================
# BDAI_SC 配置文件
# 复制为 .env 后按需修改；启动后端若没应用则在项目根目录执行：source .env
# =========================

# --------------------
# 站点地址
# --------------------
BDAI_SC_SITE_URL=http://localhost:5173
BDAI_SC_BACKEND_URL=http://localhost:8080

# --------------------
# 前端 Vite 开发服务器（仅 npm run dev 时使用）
# --------------------
# 0.0.0.0 允许局域网 / VPN 访问；仅本机开发可改为 127.0.0.1
BDAI_SC_FRONTEND_HOST=0.0.0.0
BDAI_SC_FRONTEND_PORT=5173

# --------------------
# 前端构建 / 运行时（VITE_ 前缀会注入 import.meta.env）
# --------------------
# API 根地址。留空 = 走当前页面同源 /api
#   - dev：经 Vite 反代到 8080
#   - 生产：经 Nginx 反代到 8080
# 勿填 http://127.0.0.1:8080 —— 外网/VPN 访问时审计 IP 会变成 127.0.0.1
VITE_API_BASE=

# --------------------
# 后端 Spring Boot
# --------------------
# 监听地址；Docker / 局域网部署保持 0.0.0.0
BDAI_SC_BACKEND_HOST=0.0.0.0
BDAI_SC_BACKEND_PORT=8080

# --------------------
# 数据库
# --------------------
BDAI_SC_DB_HOST=127.0.0.1
BDAI_SC_DB_PORT=3306
BDAI_SC_DB_NAME=bdai_sc
BDAI_SC_DB_USER=bdai_sc
BDAI_SC_DB_PASSWORD=bdai_sc

# --------------------
# 初始管理员（仅库中无用户时创建一次）
# --------------------
BDAI_SC_INIT_ADMIN_USERNAME=bdai
BDAI_SC_INIT_ADMIN_PASSWORD=bdai2026
BDAI_SC_INIT_ADMIN_DISPLAY_NAME=管理员

# --------------------
# 安全
# --------------------
# 浏览器 Origin 白名单，逗号分隔。生产须包含用户实际打开的地址（含端口）
# VITE_API_BASE 留空走同源 /api 时最理想；若前端指到 :8080 而页面在 :80，此项必须配对
# 例：http://172.19.21.245,http://172.19.21.245:5173,http://localhost:5173
BDAI_SC_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BDAI_SC_JWT_SECRET=bdai_sc-student-center-jwt-secret-key-change-me-in-production
BDAI_SC_JWT_EXPIRES_MINUTES=120

# --------------------
# 日志（相对路径以 backend/ 为 cwd；Docker 内一般为 /app/logs）
# --------------------
BDAI_SC_LOG_DIR=../logs

# --------------------
# 上传目录（相对 backend/ 或绝对路径；Docker 内一般为 /app/uploads）
# --------------------
BDAI_SC_UPLOAD_DIR=./uploads
